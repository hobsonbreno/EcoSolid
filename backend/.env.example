# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ecosolid_db?retryWrites=true&w=majority

# Server
PORT=3005

# CORS — frontend origin (Vercel production URL)
CORS_ORIGIN=https://ecosolid.vercel.app
# Se estiver usando preview deploy, substitua pela URL real do Vercel

# JWT (opcional — se implementar autenticação JWT futuramente)
JWT_SECRET=change-me-to-a-random-string
