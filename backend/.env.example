# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ecosolid_db?retryWrites=true&w=majority

# Server
PORT=3005

# CORS — frontend origin (Vercel production URL)
CORS_ORIGIN=https://ecosolid.vercel.app
# Se estiver usando preview deploy, substitua pela URL real do Vercel

# JWT (opcional — se implementar autenticação JWT futuramente)
JWT_SECRET=change-me-to-a-random-string

# Blockchain Sepolia
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_PRIVATE_KEY=0x...
CONTRACT_ADDRESS=0x...
# Gere a wallet: node -e "const{ethers}=require('ethers');const w=ethers.Wallet.createRandom();console.log('Address:',w.address);console.log('PrivateKey:',w.privateKey)"
# ETH de teste: https://sepoliafaucet.com
# Deploy do contrato: npx ts-node scripts/deploy-contract.ts

# Web Push / VAPID
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
# Gerar chaves: npx web-push generate-vapid-keys

# Admin
ADMIN_KEY=ecosolid-admin-2026

# Email (Gmail App Password)
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASS=xxxx

# PIX Efí Bank
EFI_SANDBOX=true
